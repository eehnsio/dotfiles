#!/bin/sh
# Losenordsvaljare i noctalias egen launcher, ersatter rofi-rbw pa Mod+P.
#
# Losenordet gar via stdin till wl-copy, aldrig som kommandoradsargument:
# `noctalia msg clipboard-copy <text>` hade lagt det i argv dar ps ser det.
set -eu

CLEAR_AFTER=45

# rbw returnerar hela mappsokvagen som ett falt ("Homelab/SSH-nycklar"), sa
# nastlade mappar faller ut gratis.
list=$(rbw ls --fields folder,name,user)

# En rad till launchern ar "titel<TAB>undertitel". noctalias dmenu delar pa
# forsta taben (dmenu_stdin_provider.cpp) och ritar titeln halvfet och
# undertiteln mindre och dampad. Utan tab blir HELA strangen halvfet titel —
# det var darfor listan sag ut som en vagg av fetstil.
#
# Titel = postens namn, undertitel = mapp och anvandarnamn. Sokningen tacker
# bada ("searchable" = titel + undertitel), sa det gar fortfarande att soka
# pa mappnamnet.
rows=$(
	printf '%s\n' "$list" |
		awk -F'\t' '
			{
				sub_ = $1
				if ($3 != "") sub_ = (sub_ == "" ? $3 : sub_ " - " $3)
				print ($2 "\t" sub_)
			}' |
		sort -f
)

sel=$(printf '%s\n' "$rows" | noctalia dmenu --prompt 'Losenord') || exit 0
[ -n "${sel:-}" ] || exit 0

# Namn ensamt racker inte for att hitta ratt post: samma namn kan finnas i
# flera mappar. Darfor slas hela raden tillbaka mot samma lista.
row=$(
	printf '%s\n' "$list" |
		awk -F'\t' -v want="$sel" '
			{
				sub_ = $1
				if ($3 != "") sub_ = (sub_ == "" ? $3 : sub_ " - " $3)
				if (($2 "\t" sub_) == want) { print $2 "\t" $3; exit }
			}'
)

[ -n "$row" ] || exit 1

name=${row%%	*}
user=${row#*	}

# --sensitive ar inte kosmetik: den lagger till mime-typen
# x-kde-passwordManagerHint, och noctalias urklippshistorik sparar inte det som
# bar den. Utan flaggan hamnar varje kopierat losenord bland de 100 senaste
# posterna i historiken, laddade av vem som helst som oppnar den.
if [ -n "$user" ]; then
	rbw get "$name" "$user" | wl-copy --sensitive
else
	rbw get "$name" | wl-copy --sensitive
fi

# Tom urklippet igen, sa losenordet inte ligger kvar resten av sessionen.
(
	sleep "$CLEAR_AFTER"
	wl-copy --clear
) >/dev/null 2>&1 &
