#!/usr/bin/env python3
"""Lösenordsväljare för Bitwarden och Vaultwarden (rbw) i rofi, på Mod+P.

Ersätter rofi-rbw. Två rader per post — namnet, och under det användarnamn och
mapp — med webbplatsens favicon framför. Utseendet är rofi/rbw.rasi.

    Enter         skriv användarnamn, Tab, lösenord i fönstret man kom från
    Ctrl+Enter    skriv bara lösenordet (inloggningar i två steg)
    Shift+Enter   som Enter, och tryck Enter efteråt
    Alt+C         kopiera lösenordet (anteckning: texten, kort: numret)
    Alt+U         kopiera användarnamnet
    Alt+T         kopiera TOTP-koden
    Alt+V         växla mellan valven

Att skriva in är för appar — webbläsartillägget fyller fortfarande webbformulär.
Fönstret som hade fokus när Mod+P trycktes läses ur niri innan rofi öppnas, och
poster som liknar dess app-id och titel hamnar överst. Efter rofi skrivs inget
förrän niri har gett tillbaka fokus till just det fönstret, och fokus kollas
igen före varje fält: har det flyttats blir det en notis i stället. Inloggningar
som inte är Login-poster, och värden med kontrolltecken, kopieras som förut.
Tangenterna går genom wtype (niri har virtual-keyboard), texten på stdin.

Två valv, var sin rbw-profil (RBW_PROFILE): cloud-Bitwarden är standard och det
man loggar in med, Vaultwarden i homelabben har maskinernas hemligheter. Varje
profil har egen agent och egen låsning.

Hemligheter går aldrig som argument: rbw skriver dem på stdout, härifrån går de
till wl-copy på stdin. `--sensitive` lägger till x-kde-passwordManagerHint, som
noctalias urklippshistorik hoppar över. Urklippet töms efter CLEAR_AFTER sekunder,
men bara om det fortfarande är hemligheten som ligger där.

Ikonerna hämtas från valvets ikontjänst i bakgrunden och cachas, så första
gången en post syns får den typens ikon och nästa gång webbplatsens. Tjänsten
ser bara domännamnen — samma sak som Bitwardens egna appar gör som standard.
"""

import html
import ipaddress
import json
import os
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

# profile = RBW_PROFILE (None = rbw:s standardprofil). Vaultwardens domäner
# stannar hemma, så de frågar Vaultwardens egen ikontjänst.
VAULTS = {
    "bitwarden": {
        "profile": None,
        "title": "Bitwarden",
        "icon": "password.svg",
        "icons": "https://icons.bitwarden.net/{host}/icon.png",
    },
    "vaultwarden": {
        "profile": "vaultwarden",
        "title": "Vaultwarden",
        "icon": "vault.svg",
        "icons": "https://vaultwarden.ehnsio.se/icons/{host}/icon.png",
    },
}
CLEAR_AFTER = 45
ICON_MAX_AGE = 30 * 86400  # en träff hämtas om efter en månad
MISS_MAX_AGE = 7 * 86400  # en miss försöks igen efter en vecka
SYNC_WARN_AGE = 86400  # synkfel blir en notis först när kopian är ett dygn gammal

CACHE = Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache") / "rbw-pick"
ICONS = CACHE / "icons"
USAGE = CACHE / "usage.json"
ROFI = Path.home() / ".config" / "rofi"

TYPE_ICON = {
    "Login": "password.svg",
    "Note": "note.svg",
    "Card": "card.svg",
    "Identity": "identity.svg",
    "SSH Key": "password.svg",
}
TYPE_LABEL = {"Note": "Anteckning", "Card": "Kort", "Identity": "Identitet", "SSH Key": "SSH-nyckel"}

# Två rader per post kräver ett annat skiljetecken än radbrytning mellan
# posterna. 0x1e (record separator) förekommer inte i postnamn.
SEP = "\x1e"

# rofi:s returkoder: 0 = Enter, 1 = Esc, 10 + n = kb-custom-(n+1).
KB_USER, KB_TOTP, KB_SWITCH, KB_PASS, KB_SUBMIT, KB_PASS_SUBMIT, KB_COPY = range(10, 17)

FOCUS_WAIT = 1.0  # så länge niri får på sig att ge tillbaka fokus efter rofi
SETTLE = 0.15  # och sedan, så att Enter och Shift hinner släppas
KEY_DELAY_MS = 5  # mellan tangenterna; Electron tappar tecken som kommer för tätt

# Ord som säger något om fönstret men inget om vilken post det gäller.
STOP_WORDS = {
    "org", "com", "net", "app", "desktop", "default", "steam", "proton", "wine",
    "firefox", "zen", "browser", "chromium", "chrome", "mozilla", "electron", "java",
    "login", "sign", "log", "window", "welcome", "the", "and", "för", "och",
}


def host_of(uri):
    """Värdnamnet att be om en ikon för, eller None.

    IP-adresser och interna namn skickas inte till ikontjänsten: den når dem
    inte ändå, och de har inget där att göra.
    """
    if "://" not in uri:
        uri = "https://" + uri
    try:
        host = urllib.parse.urlsplit(uri).hostname
    except ValueError:
        return None
    # Värdnamnet blir filnamn i cachen och sökväg i rofi-raden — bara det ett
    # riktigt värdnamn kan innehålla, så inget kontrolltecken eller / tar sig in.
    if not host or "." not in host or not all(c.isascii() and (c.isalnum() or c in ".-") for c in host):
        return None
    try:
        ipaddress.ip_address(host)
        return None
    except ValueError:
        pass
    if host.endswith((".local", ".lan", ".home.arpa", ".internal")):
        return None
    return host


def entry_host(entry):
    for uri in entry["uris"] or []:
        if host := host_of(uri):
            return host
    return None


def icon_path(entry):
    host = entry_host(entry)
    if host:
        hit = ICONS / f"{host}.png"
        if hit.exists():
            return hit
    return ROFI / "icons" / TYPE_ICON.get(entry["type"], "password.svg")


def stale_hosts(entries):
    now = time.time()
    hosts = set()
    for entry in entries:
        host = entry_host(entry)
        if not host:
            continue
        hit, miss = ICONS / f"{host}.png", ICONS / f"{host}.miss"
        if hit.exists() and now - hit.stat().st_mtime < ICON_MAX_AGE:
            continue
        if miss.exists() and now - miss.stat().st_mtime < MISS_MAX_AGE:
            continue
        hosts.add(host)
    return sorted(hosts)


def fetch(service, host):
    """Ikonens bytes, b"" om tjänsten svarar nej, None om den inte gick att nå."""
    req = urllib.request.Request(service.format(host=host), headers={"User-Agent": "rbw-pick"})
    try:
        with urllib.request.urlopen(req, timeout=10) as resp:
            return resp.read()
    except urllib.error.HTTPError:
        return b""
    except OSError:
        return None


def fetch_icons(service, hosts):
    """Körs som egen, frikopplad process — rofi ska inte vänta på nätet.

    Både Bitwardens och Vaultwardens tjänst svarar 200 även när de inte hittar
    något, med en grå jordglob. Den globen hämtas från en domän som garanterat
    inte finns och jämförs mot, så en miss blir typens ikon i stället för globen.
    """
    ICONS.mkdir(parents=True, exist_ok=True)
    placeholder = fetch(service, "rbw-pick.invalid")
    if placeholder is None:
        return  # tjänsten nås inte (Vaultwarden utanför hemmet): försök nästa gång

    def one(host):
        data = fetch(service, host)
        if data is None:
            return
        if not data or data == placeholder:
            (ICONS / f"{host}.miss").touch()
            return
        tmp = ICONS / f".{host}.tmp"
        tmp.write_bytes(data)
        tmp.rename(ICONS / f"{host}.png")
        (ICONS / f"{host}.miss").unlink(missing_ok=True)

    with ThreadPoolExecutor(max_workers=8) as pool:
        list(pool.map(one, hosts))


def load_usage():
    try:
        return json.loads(USAGE.read_text())
    except (OSError, ValueError):
        return {}


def save_usage(usage):
    CACHE.mkdir(parents=True, exist_ok=True)
    tmp = USAGE.with_suffix(".tmp")
    tmp.write_text(json.dumps(usage))
    tmp.rename(USAGE)


def clean(text):
    """Kontrolltecken bort ur det som visas.

    rofi delar posterna på SEP och läser \\0 och \\x1f som radinställningar. Ett
    postnamn med något av dem skulle dela en rad i två, och -format i:s index
    pekar då på fel post — Enter kopierar en annan posts lösenord. Namnen är
    ens egna, men delade poster och importer är det inte nödvändigtvis.
    """
    return "".join(" " if ord(c) < 32 or ord(c) == 127 else c for c in text)


def row(entry):
    sub = [clean(entry["user"])] if entry["user"] else []
    if entry["type"] in TYPE_LABEL and not sub:
        sub.append(TYPE_LABEL[entry["type"]])
    if entry["folder"]:
        sub.append(clean(entry["folder"]))
    title = html.escape(clean(entry["name"]))
    subtitle = html.escape("  ·  ".join(sub)) or "&#160;"
    text = f"<b>{title}</b>\n<span size='small' alpha='60%'>{subtitle}</span>"
    return f"{text}\0icon\x1f{icon_path(entry)}"


def notify(msg):
    subprocess.run(["notify-send", "-a", "Bitwarden", "rbw-pick", msg], check=False)


class RbwError(Exception):
    pass


def rbw_env(vault):
    env = dict(os.environ)
    env.pop("RBW_PROFILE", None)
    if vault["profile"]:
        env["RBW_PROFILE"] = vault["profile"]
    return env


def rbw(vault, *args):
    proc = subprocess.run(["rbw", *args], capture_output=True, encoding="utf-8", env=rbw_env(vault))
    if proc.returncode != 0:
        # rbw:s fel är långa och lärande — notisen får sista raden, som är
        # själva felet ("email address not set", "failed to log in" …).
        lines = [line for line in proc.stderr.strip().splitlines() if line.strip()]
        raise RbwError(f"{vault['title']}: {lines[-1].strip() if lines else f'rbw {args[0]} misslyckades'}")
    return proc.stdout


def secret_for(vault, entry):
    """Det Enter kopierar, beroende på posttyp."""
    raw = json.loads(rbw(vault, "get", "--raw", entry["id"]))
    data = raw.get("data") or {}
    match entry["type"]:
        case "Login":
            return data.get("password")
        case "Note":
            return raw.get("notes")
        case "Card":
            return data.get("number")
        case "SSH Key":
            return data.get("public_key")
    return None


def copy(value, sensitive):
    args = ["wl-copy", "--sensitive"] if sensitive else ["wl-copy"]
    subprocess.run(args, input=value, encoding="utf-8", check=True)
    if not sensitive:
        return

    # Töm efter CLEAR_AFTER sekunder i ett frikopplat barn, så att rofi och
    # niri inte väntar. Bara om urklippet fortfarande är hemligheten — har man
    # kopierat något annat under tiden får det ligga kvar.
    if os.fork() != 0:
        return
    os.setsid()
    time.sleep(CLEAR_AFTER)
    current = subprocess.run(["wl-paste", "-n"], capture_output=True, encoding="utf-8").stdout
    if current == value:
        subprocess.run(["wl-copy", "--clear"])
    os._exit(0)


def focused_window():
    """niri:s fokuserade fönster som dict, eller None (tom arbetsyta, eller niri svarar inte)."""
    proc = subprocess.run(["niri", "msg", "--json", "focused-window"], capture_output=True, encoding="utf-8")
    try:
        return json.loads(proc.stdout) if proc.returncode == 0 else None
    except ValueError:
        return None


def same_window(a, b):
    # id återanvänds inte under en niri-session; pid fångar ändå en app som
    # startats om i samma kolumn. Titeln får ändras — många appar byter titel
    # när man väl har loggat in.
    return bool(a and b) and (a["id"], a.get("pid")) == (b["id"], b.get("pid"))


def words(text):
    out, cur = set(), []
    for c in (text or "").lower() + " ":
        if c.isalnum():
            cur.append(c)
        elif cur:
            out.add("".join(cur))
            cur = []
    return {w for w in out if len(w) >= 3 and w not in STOP_WORDS}


def match_score(entry, target):
    """Hur väl en post liknar fönstret — samma idé som bw-pickers Matcher.

    App-id:ts sista led (org.gnome.Nautilus → nautilus) väger tyngst, sedan
    titelns ord. Träff i postens namn räknas högre än i dess webbadresser.
    """
    if not target:
        return 0
    name = entry["name"].lower()
    hosts = " ".join(h for uri in entry["uris"] or [] if (h := host_of(uri)))
    app = (target.get("app_id") or "").lower().rsplit(".", 1)[-1]
    score = 0
    if app in words(app):
        score += 10 * (app in name) + 8 * (app in hosts)
    for word in words(target.get("title")) - {app}:
        score += 3 * (word in name) + 2 * (word in hosts)
    return score


def type_text(target, fields, submit):
    """Skriv fälten med Tab emellan i target. False om fokus inte stämde.

    Allt går via wtype med texten på stdin, aldrig i argv. Fokus kollas före
    varje fält, så ett fönster som byts under tiden får som mest det fält som
    redan var på väg.
    """
    deadline = time.monotonic() + FOCUS_WAIT
    while not same_window(focused_window(), target):
        if time.monotonic() > deadline:
            return False
        time.sleep(0.05)
    time.sleep(SETTLE)

    for i, text in enumerate(fields):
        if not same_window(focused_window(), target):
            return False
        if i:
            subprocess.run(["wtype", "-k", "Tab"], check=True)
            time.sleep(0.03)
        subprocess.run(["wtype", "-d", str(KEY_DELAY_MS), "-"], input=text, encoding="utf-8", check=True)
    if submit:
        if not same_window(focused_window(), target):
            return False
        subprocess.run(["wtype", "-k", "Return"], check=True)
    return True


def typeable(text):
    # En radbrytning eller tab i ett lösenord skulle skicka formuläret eller
    # hoppa fält mitt i — sådant kopieras i stället.
    return bool(text) and not any(ord(c) < 32 or ord(c) == 127 for c in text)


def sync(name):
    """Synka valvet. Ett fel blir en notis först när senaste lyckade synk är
    över SYNC_WARN_AGE gammal — Vaultwarden når man inte utanför hemmet, och
    det ska inte larma varje gång. Ett fel som ligger kvar (utloggad efter
    lösenordsbyte, roterad API-nyckel) syns däremot inom ett dygn."""
    vault = VAULTS[name]
    stamp = CACHE / f"synced-{name}"
    try:
        rbw(vault, "sync")
    except RbwError as err:
        try:
            age = time.time() - stamp.stat().st_mtime
        except FileNotFoundError:
            age = float("inf")
        if age > SYNC_WARN_AGE:
            notify(f"Synken misslyckas, listan är gammal — {err}")
        return
    CACHE.mkdir(parents=True, exist_ok=True)
    stamp.touch()


def pick(name, target):
    """Visa ett valv. Returnerar namnet på valvet att växla till, eller None."""
    vault = VAULTS[name]
    other = next(n for n in VAULTS if n != name)
    entries = [e for e in json.loads(rbw(vault, "list", "--raw")) if e["type"] in TYPE_ICON]

    # rbw synkar bara var sync_interval, så en ändring i webbvalvet syns inte
    # förrän upp till en timme senare. Synka i bakgrunden varje gång: listan
    # visas direkt ur den lokala kopian, och hinner synken klart innan Enter
    # är det redan det nya lösenordet som kopieras. Nästa öppning är aktuell.
    subprocess.Popen(
        [sys.executable, __file__, "--sync", name],
        start_new_session=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )

    if hosts := stale_hosts(entries):
        subprocess.Popen(
            [sys.executable, __file__, "--fetch-icons", vault["icons"], *hosts],
            start_new_session=True,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )

    # Poster som liknar fönstret man kom från först, sedan de mest använda.
    usage = load_usage()
    entries.sort(
        key=lambda e: (
            -match_score(e, target),
            -usage.get(e["id"], 0),
            e["folder"].lower() if e["folder"] else "",
            e["name"].lower(),
        )
    )

    theme = (
        f'entry {{ placeholder: "{vault["title"]}"; }} '
        f'icon-search {{ filename: "{ROFI / "icons" / vault["icon"]}"; }}'
    )
    if target:
        keys = "<b>Enter</b> skriv in     <b>Ctrl+Enter</b> bara lösenord     <b>Alt+C</b> kopiera"
    else:
        keys = "<b>Enter</b> kopiera"
    rofi = subprocess.run(
        [
            "rofi", "-dmenu", "-i", "-markup-rows", "-no-custom",
            "-format", "i", "-sep", SEP, "-eh", "2",
            "-theme", str(ROFI / "rbw.rasi"), "-theme-str", theme,
            # rofi:s egna Shift/Ctrl+Return betyder inget med -no-custom, och
            # en tangent kan bara ha en bindning — frigör dem först.
            "-kb-accept-alt", "", "-kb-accept-custom", "", "-kb-accept-custom-alt", "",
            "-kb-custom-1", "Alt+u",
            "-kb-custom-2", "Alt+t",
            "-kb-custom-3", "Alt+v",
            "-kb-custom-4", "Control+Return",
            "-kb-custom-5", "Shift+Return",
            "-kb-custom-6", "Control+Shift+Return",
            "-kb-custom-7", "Alt+c",
            "-mesg",
            f"{keys}     <b>Alt+U</b> användarnamn     <b>Alt+T</b> TOTP"
            f"     <b>Alt+V</b> {VAULTS[other]['title']}",
        ],
        input=SEP.join(row(e) for e in entries),
        capture_output=True,
        encoding="utf-8",
    )
    code = rofi.returncode
    if code == KB_SWITCH:
        return other
    if code not in (0, KB_USER, KB_TOTP, KB_PASS, KB_SUBMIT, KB_PASS_SUBMIT, KB_COPY) or not rofi.stdout.strip():
        return None

    entry = entries[int(rofi.stdout.strip())]
    usage[entry["id"]] = usage.get(entry["id"], 0) + 1
    save_usage(usage)

    # Fel härifrån (t.ex. TOTP på en post utan) är en notis och slut — inte
    # ett valvbyte som main() gör vid fel när listan hämtas.
    try:
        if code == KB_USER:
            if entry["user"]:
                copy(entry["user"], sensitive=False)
            else:
                notify(f"{entry['name']} har inget användarnamn")
        elif code == KB_TOTP:
            copy(rbw(vault, "code", entry["id"]).strip(), sensitive=True)
        elif code != KB_COPY and target and entry["type"] == "Login":
            login(vault, entry, target, password_only=code in (KB_PASS, KB_PASS_SUBMIT),
                  submit=code in (KB_SUBMIT, KB_PASS_SUBMIT))
        elif value := secret_for(vault, entry):
            copy(value, sensitive=True)
        else:
            notify(f"{entry['name']}: inget att kopiera")
    except RbwError as err:
        notify(str(err))
    return None


def login(vault, entry, target, password_only, submit):
    password = secret_for(vault, entry)
    fields = [password] if password_only or not entry["user"] else [entry["user"], password]
    if not all(typeable(f) for f in fields):
        notify(f"{entry['name']}: går inte att skriva in — Alt+C kopierar")
        return
    if not type_text(target, fields, submit):
        notify(f"Skrev inte in {entry['name']}: fokus flyttades från {target.get('title') or target.get('app_id')}")


def main():
    if sys.argv[1:2] == ["--fetch-icons"]:
        fetch_icons(sys.argv[2], sys.argv[3:])
        return
    if sys.argv[1:2] == ["--sync"]:
        sync(sys.argv[2])
        return

    # Innan rofi öppnas — sedan har rofi fokus.
    target = focused_window()
    name, previous = "bitwarden", None
    while name:
        try:
            name, previous = pick(name, target), name
        except RbwError as err:
            notify(str(err))
            # Gick växlingen fel (Vaultwarden inte inloggat, eller utanför
            # hemmet) — tillbaka till valvet man kom från i stället för att
            # stänga. Felade det första valvet finns inget att gå tillbaka till.
            name, previous = (previous, None) if previous else (None, None)


if __name__ == "__main__":
    main()
