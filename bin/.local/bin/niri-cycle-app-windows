#!/usr/bin/env python3
"""Växla mellan fönster som tillhör samma app som det fokuserade.

Motsvarar cmd+§ / cmd+shift+§ på macOS. Niri har ingen inbyggd åtgärd för
det här, eftersom den inte grupperar fönster per app — så vi frågar IPC:n
efter alla fönster, filtrerar på app_id och hoppar till nästa i ordningen.

Anrop:  niri-cycle-app-windows [--reverse]
"""

import json
import subprocess
import sys


def niri(*args):
    return subprocess.run(
        ["niri", "msg", *args], capture_output=True, text=True, check=True
    ).stdout


def main():
    reverse = "--reverse" in sys.argv[1:]

    windows = json.loads(niri("--json", "windows"))
    focused = next((w for w in windows if w.get("is_focused")), None)
    if focused is None:
        return

    # Sortera på id så ordningen är stabil mellan anrop — annars skulle
    # cyklingen studsa mellan två fönster i stället för att gå runt.
    same_app = sorted(
        (w for w in windows if w.get("app_id") == focused.get("app_id")),
        key=lambda w: w["id"],
    )
    if len(same_app) < 2:
        return

    index = next(i for i, w in enumerate(same_app) if w["id"] == focused["id"])
    target = same_app[(index - 1 if reverse else index + 1) % len(same_app)]

    niri("action", "focus-window", "--id", str(target["id"]))


if __name__ == "__main__":
    main()
