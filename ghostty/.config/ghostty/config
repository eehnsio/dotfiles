# font-family = Berkeley Mono Variable
font-family = JetBrainsMono Nerd Font Mono
font-size = 14

adjust-cell-height = 25%
adjust-cursor-height = 25%
adjust-underline-position = 40%
adjust-underline-thickness = -60%

cursor-style = block
cursor-style-blink = true

# Cursor-trail-shader (från github.com/webhooked/.dotfiles).
# Alternativ: shaders/cursor_blaze.glsl
custom-shader = shaders/cursor_smear.glsl
custom-shader-animation = true

# no-cursor: låt inte skalet styra markörformen. Med "cursor" påslaget sätter
# zsh en stapel och skriver över cursor-style = block ovan — och shadern får
# en markör som byter form under sig.
# ssh-terminfo installerar ghosttys terminfo på fjärrhosten (kräver tic där),
# ssh-env sköter TERM-fallbacken om det misslyckas. Resten = ghosttys defaults.
shell-integration-features = no-cursor,no-sudo,title,ssh-env,ssh-terminfo,path

clipboard-paste-protection = false
unfocused-split-opacity = 0.85
unfocused-split-fill = #000000

split-divider-color = #585b70

#macos-titlebar-style = tabs
macos-titlebar-style = hidden
macos-window-buttons = hidden
macos-non-native-fullscreen = true

background-opacity = 0.90
background-blur-radius = 70

window-padding-x = 10
window-padding-y = 10
window-padding-balance = true
window-padding-color = extend 

# Temat sätter bakgrunden själv (#16181d, samma yta som DMS-panelerna).
# Ingen explicit background-rad här: den skulle ligga EFTER theme och därmed
# vinna, vilket är hur den gamla Tokyo Night-bakgrunden överlevde temabytet.
theme = drivis

copy-on-select = clipboard

keybind = shift+enter=text:\x1b\r

# Jämna ut splits (som en tiling wm)
keybind = cmd+shift+e=equalize_splits

# Maskinspecifikt sist, sa det vinner over allt ovan. ?-prefixet gor filen
# valfri — ghostty klagar inte om den saknas.
config-file = ?config.local
