[Desktop Entry]
Type=Application
Name=Noctalia Settings
Comment=Noctalias inställningar (paketets egen post startar bara skalet)
Exec=sh -c "noctalia msg settings-open || { noctalia --daemon && noctalia msg settings-open; }"
Icon=noctalia
Terminal=false
Categories=Settings;DesktopSettings;
Keywords=noctalia;settings;inställningar;shell;bar;
