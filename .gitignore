.DS_Store
ssh/

# Privata skills (ej för publicering)
claude/.claude/skills/*-private/
claude/.claude/skills/ehnsio-review/
claude/.claude/skills/ehnsio-write/

# Anthropics egna skills, autosyncade fran claude.ai-kontot. Landar HAR och inte
# i $HOME eftersom stow foldar hela skills-katalogen till en enda symlank —
# allt Claude Code skriver i ~/.claude/skills hamnar alltsa i repot. Samma
# sak galler commands/ och hooks/, som ocksa ar foldade.
# Katalognamnet ar konto-uuid, sa det ar varken portabelt eller vart att spara;
# filerna hamtas per maskin.
claude/.claude/skills/synced/

# Privat zsh-config
zsh/.zshrc.local

# Beroenden i skill-scripts
node_modules/

# Sparade browser-sessioner (cookies/tokens)
.auth/

# Maskinspecifikt (skarmar, fontstorlek) — skapas av install fran .example
niri/.config/niri/local.kdl
ghostty/.config/ghostty/config.local
__pycache__/
