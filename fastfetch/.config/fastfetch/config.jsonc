// Standardvyn: miljon man sitter i. Hardvaran visas med `ffhw`.
//
// Ikon OCH text i nyckeln: ikonen ensam kraver att man vet vad varje glyf
// betyder. Ikonerna ar Nerd Font-glyfer ur Font Awesome-omradet
// (\uf0xx-\uf2xx), som finns i alla Nerd Fonts.
//
// keyWidth ger raka kolon; utan den blir de raggiga eftersom nycklarna ar
// olika langa. Escape-sekvenser MASTE skrivas \u001b i JSON.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "padding": { "top": 1, "right": 3 } },
  "display": { "separator": " : ", "key": { "width": 21 } },
  // Ingen "title"-modul: den skriver ut anvandare@vardnamn.
  "modules": [
    { "type": "custom", "format": "\u001b[90m─────────────\u001b[0m System \u001b[90m─────────────\u001b[0m" },
    { "type": "os", "key": " \u2502  \uf17c  OS", "keyColor": "cyan" },
    { "type": "kernel", "key": " \u2502  \uf085  Kernel", "keyColor": "cyan" },
    { "type": "packages", "key": " \u2502  \uf187  Packages", "keyColor": "cyan" },
    { "type": "shell", "key": " \u2502  \uf489  Shell", "keyColor": "cyan" },
    "break",
    { "type": "custom", "format": "\u001b[90m─────────────\u001b[0m Session \u001b[90m─────────────\u001b[0m" },
    { "type": "wm", "key": " \u2502  \uf2d0  WM", "keyColor": "magenta" },
    { "type": "lm", "key": " \u2502  \uf023  Login", "keyColor": "magenta" },
    { "type": "terminal", "key": " \u2502  \uf120  Terminal", "keyColor": "magenta" },
    { "type": "terminalfont", "key": " \u2502  \uf031  Font", "keyColor": "magenta" },
    "break",
    { "type": "custom", "format": "\u001b[90m─────────────\u001b[0m Uptime \u001b[90m─────────────\u001b[0m" },
    { "type": "uptime", "key": " \u2502  \uf017  Uptime", "keyColor": "blue" },
    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 5 }
  ]
}
