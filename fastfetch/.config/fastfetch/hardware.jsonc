// Hardvaruvyn. Visas med `ffhw` (fastfetch --config hardware).
//
// Stilen: custom-moduler ritar rubrikraderna, nycklarna bar en enhetlig ledstang. Trad-
// kopplingar (┌ ├ └) blir fel sa fort en modul ger noll eller flera rader,
// vilket host, gpu och display gor, och ikonerna ar Nerd Font-glyfer ur Font Awesome-omradet
// (\uf0xx-\uf2xx) som finns i alla Nerd Fonts. Terminalen kor UbuntuMono
// Nerd Font Mono.
//
// Escape-sekvenser MASTE skrivas \u001b i JSON — raa kontrolltecken avvisas.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "padding": { "top": 1, "right": 3 } },
  "display": { "separator": " : " },
  // Ingen "title"-modul: den skriver ut anvandare@vardnamn, vilket ar
  // onodigt att exponera i skarmdumpar och delade terminaler.
  "modules": [
    { "type": "custom", "format": "\u001b[90m──────────────\u001b[0m Machine \u001b[90m──────────────\u001b[0m" },
    { "type": "host", "key": " \u250c  \uf108  ", "keyColor": "cyan" },
    { "type": "cpu", "key": " \u251c  \uf2db  ", "keyColor": "cyan" },
    { "type": "gpu", "key": " \u2514  \uf1b2  ", "keyColor": "cyan" },
    "break",
    { "type": "custom", "format": "\u001b[90m──────────────\u001b[0m Memory \u001b[90m──────────────\u001b[0m" },
    { "type": "memory", "key": " \u250c  \uf1c0  ", "keyColor": "magenta" },
    { "type": "swap", "key": " \u251c  \uf0c7  ", "keyColor": "magenta" },
    { "type": "disk", "key": " \u2514  \uf0a0  ", "keyColor": "magenta" },
    "break",
    { "type": "custom", "format": "\u001b[90m──────────────\u001b[0m Displays \u001b[90m──────────────\u001b[0m" },
    { "type": "display", "key": " \u2514  \uf108  ", "keyColor": "blue" },
    "break",
    "colors"
  ]
}
