// Hardvaruvyn. Visas med `ffhw`.
//
// Ikon OCH text i nyckeln: ikonen ensam kraver att man vet vad varje glyf
// betyder. Ikonerna ar Nerd Font-glyfer ur Font Awesome-omradet
// (\uf0xx-\uf2xx), som finns i alla Nerd Fonts.
//
// keyWidth ger raka kolon; utan den blir de raggiga eftersom nycklarna ar
// olika langa. Escape-sekvenser MASTE skrivas \u001b i JSON.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "padding": { "top": 1, "right": 3 } },
  "display": { "separator": " : ", "key": { "width": 16 } },
  // Ingen "title"-modul: den skriver ut anvandare@vardnamn.
  "modules": [
    { "type": "custom", "format": "\u001b[90m─────────────\u001b[0m Machine \u001b[90m─────────────\u001b[0m" },
    { "type": "board", "key": " \u2502  \uf108  Board", "keyColor": "cyan" },
    { "type": "cpu", "key": " \u2502  \uf2db  CPU", "keyColor": "cyan" },
    { "type": "gpu", "key": " \u2502  \uf1b2  GPU", "keyColor": "cyan" },
    "break",
    { "type": "custom", "format": "\u001b[90m─────────────\u001b[0m Memory \u001b[90m─────────────\u001b[0m" },
    { "type": "memory", "key": " \u2502  \uf1c0  Memory", "keyColor": "magenta" },
    { "type": "swap", "key": " \u2502  \uf0c7  Swap", "keyColor": "magenta" },
    { "type": "disk", "key": " \u2502  \uf0a0  Disk", "keyColor": "magenta" },
    "break",
    { "type": "custom", "format": "\u001b[90m─────────────\u001b[0m Displays \u001b[90m─────────────\u001b[0m" },
    { "type": "display", "key": " \u2502  \uf108  Display", "keyColor": "blue" },
    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 5 }
  ]
}
