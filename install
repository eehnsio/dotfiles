#!/usr/bin/env zsh

# Set defaults if not already set
if [[ -z $STOW_FOLDERS ]]; then
    STOW_FOLDERS="bin,claude,ghostty,lsd,nvim,zsh"

    # niri, xremap, dms och spotify finns bara på Linux.
    #
    # Listan är avsiktligt explicit och inte "allt som är en katalog":
    # reference/ och .github/ ligger också på toppnivån men ska aldrig stowas.
    if [[ "$(uname)" == "Linux" ]]; then
        STOW_FOLDERS="$STOW_FOLDERS,niri,xremap,dms,spotify"
    fi
fi

if [[ -z $DOTFILES ]]; then
    DOTFILES="$(cd "$(dirname "$0")" && pwd)"
fi

# Merge-drivrutinen som .gitattributes hänvisar till. Utan den ignorerar git
# raderna där tyst, och lockfilerna börjar konflikta mellan maskinerna igen.
# "true" betyder bara: lyckas alltid, behåll vår version.
if git -C "$DOTFILES" rev-parse --git-dir >/dev/null 2>&1; then
    git -C "$DOTFILES" config merge.ours.driver true
fi

# Maskinspecifika filer skapas från sina .example innan stow körs.
#
# De är gitignorerade men ligger inuti paketen, så stow symlänkar dem som
# vanligt — innehållet stannar lokalt medan sökvägen är densamma överallt.
# niri är kinkig här: den vägrar starta om en include saknas, så filen måste
# finnas redan första gången.
seed_local() {
    local target=$1 template=$2
    if [[ ! -f $target ]]; then
        echo "skapar $target från $(basename $template)"
        cp $template $target
    fi
}

seed_local "$DOTFILES/niri/.config/niri/local.kdl" \
           "$DOTFILES/niri/.config/niri/local.kdl.example"
seed_local "$DOTFILES/ghostty/.config/ghostty/config.local" \
           "$DOTFILES/ghostty/.config/ghostty/config.local.example"

# Install each package
pushd $DOTFILES
for folder in $(echo $STOW_FOLDERS | sed "s/,/ /g")
do
    echo "stow $folder"
    stow -D --target=$HOME --verbose $folder
    stow --target=$HOME --verbose $folder
done
popd
